{
  "name": "pinch",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "dev:api": "npm run dev -w server",
    "dev:worker": "npm run dev:worker -w server",
    "db:indexes": "npm run db:indexes -w server",
    "db:seed": "npm run db:seed -w server",
    "db:backfill-link-keys": "npm run db:backfill-link-keys -w server",
    "db:adopt-dev-data": "npm run db:adopt-dev-data -w server",
    "format": "prettier --write .",
    "check": "prettier --check . && npm run check --workspaces",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "mongodb": "^7.8.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
